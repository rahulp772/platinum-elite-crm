# ===================
# SERVER
# ===================
PORT=3001

# ===================
# DATABASE
# ===================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=real_estate_crm

# ===================
# AUTHENTICATION
# ===================
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=86400

# ===================
# AUDIT & MONITORING
# ===================
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365

# ===================
# CORS
# ===================
# Multiple origins separated by comma
# Example: CORS_ORIGINS=http://localhost:3000,https://admin.makeitcrm.com
CORS_ORIGINS=http://localhost:3000

# ===================
# ACCOUNT SECURITY
# ===================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ===================
# PASSWORD POLICY
# ===================
PASSWORD_MIN_LENGTH=8

# ===================
# DATA RETENTION
# ===================
DATA_RETENTION_DAYS=2555

THROTTLE_TTL (default: 60000)
THROTTLE_LIMIT (default: 100)
THROTTLE_SHORT_TTL (default: 1000)
THROTTLE_SHORT_LIMIT (default: 10)

# ===================
# REDIS (for BullMQ)
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===================
# AWS S3 (for file storage)
# ===================
AWS_S3_BUCKET=temp-imports
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===================
# IMPORT SETTINGS
# ===================
IMPORT_BATCH_SIZE=500
IMPORT_FILE_RETENTION_HOURS=24